{
  "name": "rankers-mind/crm",
  "description": "Rankers Mind staff, sales, projects, attendance, payroll and billing CRM",
  "type": "project",
  "license": "proprietary",
  "require": {
    "php": ">=8.0",
    "dompdf/dompdf": "^3.1.6",
    "phpmailer/phpmailer": "^7.1"
  },
  "require-dev": {
    "phpstan/phpstan": "^2.1",
    "phpunit/phpunit": "^9.6",
    "squizlabs/php_codesniffer": "^3.13"
  },
  "scripts": {
    "lint": ["@php tools/lint.php", "phpcs"],
    "typecheck": "phpstan analyse --memory-limit=512M",
    "test": "phpunit",
    "check": ["@lint", "@typecheck", "@test"]
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/"
    }
  },
  "config": {
    "optimize-autoloader": true,
    "sort-packages": true
  }
}
