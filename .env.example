APP_NAME="Rankers Mind CRM"
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost/rankers-mind-crm/public
APP_TIMEZONE=Asia/Kolkata
APP_KEY=replace-with-a-long-random-key
SESSION_LIFETIME=120
SESSION_SECURE=false

# Used only once by `php install.php` when the users table is empty.
INITIAL_ADMIN_NAME="Rankers Mind Administrator"
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
INITIAL_ADMIN_PHONE=

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=rankers_mind_crm
DB_USERNAME=root
DB_PASSWORD=

MAIL_ENABLED=false
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@rankersmind.com
MAIL_FROM_NAME="Rankers Mind CRM"

UPLOAD_MAX_MB=5
REMINDER_CRON_KEY=change-this-before-production
